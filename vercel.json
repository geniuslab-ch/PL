{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/signal", "destination": "/signal/index.html" },
    { "source": "/signal/", "destination": "/signal/index.html" },
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/", "destination": "/en/index.html" },
    { "source": "/en/signal", "destination": "/en/signal/index.html" },
    { "source": "/en/signal/", "destination": "/en/signal/index.html" }
  ]
}
